# AuditPilot optional LLM polish — all three must be set to enable it.
# Without them the offline narrator is used (full functionality).
AUDITPILOT_LLM_BASE_URL=https://api.openai.com/v1
AUDITPILOT_LLM_API_KEY=
AUDITPILOT_LLM_MODEL=gpt-4o-mini

# Web app port (HF Spaces and Render set this automatically).
PORT=7860
